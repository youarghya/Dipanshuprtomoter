# ============================================================
# Dipanshu Promoter & Builder - environment variables
# ============================================================
# This project currently needs NO environment variables.
# It runs entirely in the browser and stores data in localStorage.
#
# Copy this file to ".env" only when you start using the
# optional settings below. Never commit ".env".
#
# IMPORTANT: Vite exposes every VITE_* variable to the browser.
# Never put real secrets (private API keys, passwords, tokens)
# in a VITE_* variable - they end up in the public JavaScript.
# ============================================================

# ---- Deployment ----
# Only used if the site is hosted in a subfolder, e.g. GitHub Pages.
# Requires a matching "base" setting in vite.config.js.
# VITE_BASE_PATH=/Dipanshuprtomoter/

# ---- Future backend (example: Supabase public anon values) ----
# Safe to expose only when row-level security is enabled.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# ---- Optional public settings ----
# WhatsApp number in international format, digits only.
# VITE_WHATSAPP_NUMBER=919999999999
# Google Analytics 4 measurement id.
# VITE_GA_MEASUREMENT_ID=
