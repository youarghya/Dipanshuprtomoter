# ============================================================
# Dipanshu Promoter & Builder - environment reference
# ============================================================
# Copy this file to ".env" for local overrides.
#
# Vite loads these files in order (later wins):
#   .env  ->  .env.[mode]  ->  .env.[mode].local
#
# !! SECURITY !!
# Every VITE_* variable is compiled into the public JavaScript
# bundle. Never store API secrets, passwords or private tokens
# here. Private values belong on a server, not in a Vite app.
# ============================================================

# Origin of the deployed site: scheme + host + port, with no path
# and no trailing slash. The base path below is appended to it.
# Local:   http://localhost:5173
# GitHub:  https://youarghya.github.io
VITE_SITE_URL=http://localhost:5173

# Path the app is served from. Always starts and ends with "/".
# Domain root:            /
# GitHub Pages project:   /Dipanshuprtomoter/
VITE_BASE_PATH=/

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to load no analytics at all.
VITE_GA_MEASUREMENT_ID=
